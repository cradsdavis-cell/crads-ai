// host.rc: resources for the Crads-AI window host. Icon 1 is the mark
// (crads-ai.ico is generated by make-icon.mjs at build time and copied here
// by the workflow; no binary blobs in git).
1 ICON "crads-ai.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Crads-AI"
      VALUE "FileDescription", "Crads-AI"
      VALUE "CompanyName", "crads-ai.com"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
