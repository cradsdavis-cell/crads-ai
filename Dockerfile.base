# ============================================================================
# ai-os-base — shared runtime for the member + rock variants.
# A runtime, not a runnable box: no WORKDIR/app content, no COPY, no entrypoint.
# The slow steps (code-server download + the 3-plugin bake) live here so both
# variants reuse the layer. Split from the single Dockerfile 2026-07-16.
# ============================================================================
FROM node:24-slim

# openssh-client is the one net-new package vs the old single image: the member's
# ic-sync ssh:// pull needs `ssh`, the rock's stamp-pebble needs `ssh-keygen`.
# openssh-sftp-server (2026-07-23): the Claude Code desktop app opens an SFTP
# subsystem to bootstrap its remote agent. The host sshd force-commands every
# login into THIS container (enter-aios), so the sftp branch of enter-aios hands
# off to /usr/lib/openssh/sftp-server IN HERE, which must therefore exist. Without
# it the app fails at connect time with "Couldn't open an SFTP session".
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl tini python3 python3-venv cron gnupg openssh-client openssh-sftp-server \
    && rm -rf /var/lib/apt/lists/*

# --- workspace-mcp (PINNED): serves a member's BYO-Google connection ---
# Baked, not fetched on demand: the box has no uv, and a first tool call that
# waits on a pip download is indistinguishable from broken. The version is
# pinned because engine/comms/mcp-token.mjs writes this exact package's
# credential-file schema (docs/design-google-byo-connect.md § serving server);
# bump the two together. mcp-connect.mjs add-google points at this path (GWS_BIN).
ARG WORKSPACE_MCP_VERSION=1.24.1
RUN python3 -m venv /opt/gws \
    && /opt/gws/bin/pip install --no-cache-dir "workspace-mcp==${WORKSPACE_MCP_VERSION}" \
    && /opt/gws/bin/workspace-mcp --help >/dev/null

# GitHub CLI (device-flow backup auth). cron drives the optional per-box cadence.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# git: trust the mounted repo regardless of owner uid; force HTTPS for any SSH refs.
RUN git config --system --add safe.directory '*' \
    && git config --system url."https://github.com/".insteadOf "git@github.com:"

# --- Claude Code CLI (PINNED — the plugin-bake contract depends on a fixed CLI) ---
ARG CLAUDE_CLI_VERSION=2.1.187
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CLI_VERSION}"

# --- Browser VS Code: code-server (MIT), server bundled, no runtime download ---
ARG CS_VERSION=4.125.0
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in arm64) A=arm64 ;; *) A=amd64 ;; esac; \
    curl -fL "https://github.com/coder/code-server/releases/download/v${CS_VERSION}/code-server-${CS_VERSION}-linux-${A}.tar.gz" \
      | tar -C /opt -xz; \
    ln -sf "/opt/code-server-${CS_VERSION}-linux-${A}/bin/code-server" /usr/local/bin/code-server; \
    code-server --version

# --- Claude Code VS Code extension (baked outside /state; world-readable) ---
ENV CODE_SERVER_EXTENSIONS_DIR=/opt/vscode-extensions
RUN code-server --extensions-dir "$CODE_SERVER_EXTENSIONS_DIR" --install-extension anthropic.claude-code \
    && code-server --extensions-dir "$CODE_SERVER_EXTENSIONS_DIR" --list-extensions \
    && chmod -R a+rX "$CODE_SERVER_EXTENSIONS_DIR"

# --- Pre-bake the 3 Claude Code plugins (no login; clone public repos) ---
RUN set -eux; \
    export CLAUDE_CONFIG_DIR=/state/.claude-auth; \
    mkdir -p "$CLAUDE_CONFIG_DIR"; \
    claude plugin marketplace add anthropics/claude-plugins-official; \
    claude plugin marketplace add obra/superpowers-marketplace; \
    claude plugin marketplace add jnuyens/gsd-plugin; \
    claude plugin install superpowers@superpowers-marketplace; \
    claude plugin install gsd@gsd-plugin; \
    claude plugin install skill-creator@claude-plugins-official; \
    claude plugin list; \
    cp -a /state/.claude-auth /opt/claude-plugins-template; \
    rm -rf /state

# --- OpenCode: the second harness (spec docs/superpowers/specs/2026-09-17-second-harness-design.md) ---
# PINNED for the same reason the Claude CLI is: the conformance suite and the compatibility
# matrix are statements about ONE version. A bump re-runs both. Build with
# --build-arg OPENCODE_VERSION= (empty) to leave the harness and its ~270 MB out entirely.
ARG OPENCODE_VERSION=1.18.31
ARG GSD_CORE_VERSION=1.14.0
ARG SUPERPOWERS_TAG=v6.3.0
ARG CLAUDE_PLUGINS_OFFICIAL_SHA=ea0a38e1d671aa18a30431c9160e31193dc9860b
RUN set -eux; \
    [ -n "${OPENCODE_VERSION}" ] || { echo "OpenCode bake skipped"; exit 0; }; \
    npm install -g "opencode-ai@${OPENCODE_VERSION}"; \
    opencode --version; \
    R=/state/.opencode-auth; C="$R/config/opencode"; mkdir -p "$C"; \
    export XDG_CONFIG_HOME="$R/config" XDG_DATA_HOME=/tmp/oc-bake/data XDG_STATE_HOME=/tmp/oc-bake/state XDG_CACHE_HOME="$R/cache" \
           OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_SHARE=1; \
    HOME=/tmp/oc-bake/home npx -y "@opengsd/gsd-core@${GSD_CORE_VERSION}" --opencode --global --config-dir "$C" --no-legacy-cleanup; \
    git clone --quiet https://github.com/anthropics/claude-plugins-official /tmp/oc-bake/cpo; \
    git -C /tmp/oc-bake/cpo checkout --quiet "${CLAUDE_PLUGINS_OFFICIAL_SHA}"; \
    mkdir -p "$C/skills"; cp -a /tmp/oc-bake/cpo/plugins/skill-creator/skills/skill-creator "$C/skills/skill-creator"; \
    cp /tmp/oc-bake/cpo/plugins/skill-creator/LICENSE "$C/skills/skill-creator/LICENSE"; \
    node -e 'const fs=require("fs"),p=process.argv[1]+"/opencode.json";const j=fs.existsSync(p)?JSON.parse(fs.readFileSync(p,"utf8")):{};j.plugin=[...(j.plugin||[]),"superpowers@git+https://github.com/obra/superpowers.git#"+process.argv[2]];if(j.mcp&&j.mcp.gsd)j.mcp.gsd.command=["npx","-y","-p","@opengsd/gsd-core@"+process.argv[3],"gsd-mcp-server"];j.autoupdate=false;j.share="disabled";fs.writeFileSync(p,JSON.stringify(j,null,2)+"\n")' "$C" "${SUPERPOWERS_TAG}" "${GSD_CORE_VERSION}"; \
    mkdir -p /tmp/oc-bake/ws; cd /tmp/oc-bake/ws; git init -q; \
    opencode debug skill > /tmp/oc-bake/skills.json; \
    node -e 'const n=JSON.parse(require("fs").readFileSync("/tmp/oc-bake/skills.json","utf8")).map(s=>s.name);for(const w of ["brainstorming","skill-creator","gsd-new-project"])if(!n.includes(w)){console.error("bake: skill missing: "+w);process.exit(1)}console.log("opencode bake: "+n.length+" skills")'; \
    cd /; mkdir -p /opt/opencode-template; cp -a "$R/config" "$R/cache" /opt/opencode-template/; \
    chmod -R a+rX /opt/opencode-template; npm cache clean --force >/dev/null 2>&1 || true; rm -rf /state /tmp/oc-bake /root/.npm /root/.cache
# Notes on the bake above, kept out of the RUN so a comment cannot break its continuation:
#  - Baked AT the path a mineral uses, then moved aside, exactly like the Claude bake: GSD
#    writes its absolute install path into a few hundred files. engine/box/opencode-seed.sh
#    rewrites it for a mineral mounted anywhere else.
#  - GSD's installer also writes ~/.gsd/defaults.json (runtime: opencode). HOME is a throwaway
#    so that never lands in a home the Claude-side GSD plugin shares.
#  - skill-creator is Apache-2.0: copied with its licence, never vendored into this AGPL repo.
#  - GSD ships its MCP server as `npx -y -p @opengsd/gsd-core`, which fetches whatever is
#    NEWEST each time a member opens a terminal. Pinned to GSD_CORE_VERSION instead. Still an
#    npx fetch on first use: a global install of the package cost ~100 MB of layer and ran
#    the CI runner out of disk (2026-09-17), and the terminal is online by definition.
#  - The npm cache is cleared in the SAME layer: left behind it is dead weight in every image.
#  - The last node step PROVES one skill from each of the three plugins is discoverable, so a
#    silently failed install fails the build instead of shipping an empty template.

ENV STATE_DIR=/state \
    CLAUDE_CONFIG_DIR=/state/.claude-auth \
    CLAUDE_PLUGIN_TEMPLATE=/opt/claude-plugins-template \
    OPENCODE_PLUGIN_TEMPLATE=/opt/opencode-template
VOLUME ["/state"]
# Variants add WORKDIR /app, COPYs, and the entrypoint. Deliberately no jq (rock-only).
